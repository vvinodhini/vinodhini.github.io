<style>
/* Layout concept: the portfolio reads like a product detail page for a person.
   A data-sheet hero, a live "one record, many channels" syndication demo, then
   experience, skills, brands, contact. */
:root {
  --bg: #EDF2EE;
  --surface: #FFFFFF;
  --soft: #DCE7E0;
  --ink: #12201A;
  --muted: #55655D;
  --line: #CAD6CE;
  --accent: #D9481F;
  --accent-ink: #FFFFFF;
  --ok: #1E7A4C;
  --warn: #B3261E;
  --font-display: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
  --font-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1713; --surface: #16231D; --soft: #1F3029; --ink: #E7F0EA; --muted: #9AAEA3;
    --line: #2B3F36; --accent: #FF7A4D; --accent-ink: #1A0B05; --ok: #55C98A; --warn: #FF8A80;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1713; --surface: #16231D; --soft: #1F3029; --ink: #E7F0EA; --muted: #9AAEA3;
  --line: #2B3F36; --accent: #FF7A4D; --accent-ink: #1A0B05; --ok: #55C98A; --warn: #FF8A80;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.6;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 20px 56px;
}
.wrap { max-width: 1080px; margin: 0 auto; display: flex; flex-direction: column; gap: 88px; }
h1, h2, h3 { font-family: var(--font-display); line-height: 1.05; margin: 0; text-wrap: balance; letter-spacing: -0.02em; }
p { margin: 0; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.mono { font-family: var(--font-mono); }
.eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

/* header */
.top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
.brand { font-family: var(--font-display); font-weight: 800; font-size: 18px; letter-spacing: -0.01em; text-decoration: none; }
.nav { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; }
.nav a { text-decoration: none; color: var(--muted); padding: 4px 0; border-bottom: 2px solid transparent; }
.nav a:hover { color: var(--ink); border-color: var(--accent); }

/* hero */
.hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 40px; align-items: start; padding-top: 40px; }
.hero h1 { font-size: clamp(44px, 8vw, 92px); font-weight: 800; }
.hero h1 span { color: var(--accent); }
.hero .lede { font-size: 20px; max-width: 34ch; margin-top: 24px; color: var(--ink); }
.hero .sub { margin-top: 14px; color: var(--muted); max-width: 46ch; }
.cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.btn { font: 600 15px var(--font-body); padding: 12px 20px; border-radius: 10px; border: 2px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; text-decoration: none; display: inline-block; transition: transform .15s ease, background .15s ease; }
.btn:hover { transform: translateY(-2px); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

.sheet { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.sheet-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.pill { font-family: var(--font-mono); font-size: 12px; padding: 4px 10px; border-radius: 999px; background: var(--soft); color: var(--ink); white-space: nowrap; }
.pill.ok { color: var(--ok); }
.pill.bad { color: var(--warn); }
.pill .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: currentColor; margin-right: 6px; }
dl.rows { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0; }
dl.rows dt, dl.rows dd { padding: 10px 0; border-top: 1px solid var(--line); margin: 0; }
dl.rows dt { font-family: var(--font-mono); font-size: 12px; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; padding-right: 20px; padding-top: 13px; }
dl.rows dd { font-size: 15px; overflow-wrap: anywhere; }
.stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.stat { border-top: 3px solid var(--accent); padding-top: 8px; }
.stat b { font-family: var(--font-display); font-size: 32px; font-weight: 800; display: block; line-height: 1; letter-spacing: -0.02em; }
.stat span { font-size: 13px; color: var(--muted); }

/* sections */
.sec-head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; max-width: 60ch; }
.sec-head h2 { font-size: clamp(30px, 5vw, 48px); font-weight: 800; }
.sec-head p { color: var(--muted); }

/* demo */
.demo { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 24px; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 28px; }
.demo h3 { font-size: 20px; margin-bottom: 12px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { font: 500 14px var(--font-body); padding: 7px 13px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); color: var(--ink); cursor: pointer; transition: background .15s, border-color .15s; }
.chip:hover { border-color: var(--ink); }
.chip[aria-pressed="true"], .chip[aria-selected="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.chip.gone[aria-pressed="true"] { background: transparent; color: var(--warn); border-color: var(--warn); text-decoration: line-through; }
.record { margin-top: 18px; }
.hint { font-size: 13px; color: var(--muted); margin-top: 12px; }
.out { background: var(--bg); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.out-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
.count { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
.count.over { color: var(--warn); }
.out ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
.out-meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
.attr { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 16px; font-size: 14px; margin: 0; }
.attr dt { font-family: var(--font-mono); color: var(--muted); font-size: 12px; text-transform: uppercase; padding-top: 2px; }
.attr dd { margin: 0; }
.attr .miss { color: var(--warn); font-family: var(--font-mono); }

/* experience */
.roles { display: flex; flex-direction: column; border-top: 2px solid var(--ink); }
.role { border-bottom: 1px solid var(--line); }
.role summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 20px; align-items: baseline; padding: 22px 0; }
.role summary::-webkit-details-marker { display: none; }
.role .co { font-family: var(--font-display); font-size: clamp(26px, 4vw, 40px); font-weight: 800; letter-spacing: -0.02em; }
.role .title { color: var(--muted); font-size: 15px; grid-column: 1; }
.role .when { font-family: var(--font-mono); font-size: 13px; color: var(--muted); grid-column: 2; grid-row: 1; white-space: nowrap; }
.role .plus { grid-column: 2; grid-row: 2; justify-self: end; font-family: var(--font-mono); font-size: 20px; color: var(--accent); transition: transform .2s; }
.role[open] .plus { transform: rotate(45deg); }
.role summary:hover .co { color: var(--accent); }
.role .body { padding: 0 0 26px; display: flex; flex-wrap: wrap; gap: 8px; max-width: 70ch; }
.tag { font-size: 14px; padding: 6px 12px; border-radius: 8px; background: var(--soft); }

/* skills */
.skill-panel { display: flex; flex-direction: column; gap: 20px; }
.skill-grid { display: flex; flex-wrap: wrap; gap: 10px; min-height: 120px; align-content: flex-start; }
.skill { font-size: 16px; padding: 10px 16px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
.skill.tool { font-family: var(--font-mono); font-size: 14px; }

.cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
.cols h3 { font-size: 24px; margin-bottom: 16px; }
.list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.list li { padding: 13px 0; border-top: 1px solid var(--line); display: flex; gap: 12px; }
.list li::before { content: ""; flex: none; width: 10px; height: 10px; margin-top: 8px; background: var(--accent); border-radius: 2px; }

/* brands */
.brands { display: flex; flex-wrap: wrap; gap: 8px 10px; }
.brand-tag { font-family: var(--font-display); font-weight: 700; font-size: 18px; padding: 8px 14px; border-radius: 10px; border: 1.5px solid var(--line); background: var(--surface); transition: border-color .15s, transform .15s; }
.brand-tag:hover { border-color: var(--accent); transform: translateY(-2px); }

/* vendor logo wall */
.focus { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
.focus .chip { cursor: default; background: var(--ink); color: var(--bg); border-color: var(--ink); }
.logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
.logo { background: #FFFFFF; border: 1px solid var(--line); border-radius: 12px; height: 92px; padding: 14px; display: flex; align-items: center; justify-content: center; transition: transform .15s, border-color .15s; }
.logo:hover { transform: translateY(-3px); border-color: var(--accent); }
.logo img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

/* ERP to PDP example */
.seg { display: inline-flex; border: 2px solid var(--ink); border-radius: 12px; overflow: hidden; margin-bottom: 20px; max-width: 100%; }
.seg button { font: 600 15px var(--font-body); padding: 11px 18px; border: 0; background: transparent; color: var(--ink); cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.pdp-wrap { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 24px; min-width: 0; }
.score { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; align-items: center; margin-bottom: 20px; }
.bar { height: 10px; border-radius: 6px; background: var(--soft); overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--accent); transition: width .5s ease; }
.score b { font-family: var(--font-display); font-size: 28px; font-weight: 800; }
.erp-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; }
.erp { background: #0F1A15; color: #BFE8CF; border-radius: 12px; padding: 16px; font-family: var(--font-mono); font-size: 13px; line-height: 1.7; overflow-x: auto; }
.erp div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 8px; white-space: nowrap; }
.erp span:first-child { color: #6E8E7D; }
.erp-title { font-family: var(--font-mono); font-size: 12px; color: #6E8E7D; margin-bottom: 8px; letter-spacing: .08em; }
.checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.checks li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 15px; }
.checks li:first-child { border-top: 0; }
.checks .pill { flex: none; }
.pdp-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
.stage { aspect-ratio: 1 / 1; background: var(--soft); border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; max-width: 100%; }
.stage svg { width: 100%; height: 100%; display: block; }
.thumbs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
.thumbs button { padding: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--soft); cursor: pointer; aspect-ratio: 1 / 1; }
.thumbs button[aria-pressed="true"] { border-color: var(--accent); }
.thumbs svg { width: 100%; height: 100%; display: block; }
.note { font-size: 12px; font-family: var(--font-mono); color: var(--muted); margin-top: 8px; }
.pdp-info h3 { font-size: clamp(24px, 3.4vw, 34px); line-height: 1.1; }
.pdp-info .sku { font-family: var(--font-mono); font-size: 13px; color: var(--muted); margin-top: 10px; }
.badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
.badge { font: 600 13px var(--font-body); padding: 6px 10px; border-radius: 8px; background: var(--ink); color: var(--bg); }
.badge.alt { background: var(--soft); color: var(--ink); }
.pdp-info ul { margin: 14px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
.pdp-tabs { margin-top: 28px; }
.tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
.tbl th, .tbl td { text-align: left; padding: 10px 12px 10px 0; border-top: 1px solid var(--line); vertical-align: top; }
.tbl th { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 500; width: 38%; }
.scroll-x { overflow-x: auto; max-width: 100%; }
.two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
.yn { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
.yn div { display: flex; justify-content: space-between; padding: 9px 0; border-top: 1px solid var(--line); font-size: 15px; gap: 8px; }
.yes { color: var(--ok); font-family: var(--font-mono); font-size: 13px; }
.no { color: var(--muted); font-family: var(--font-mono); font-size: 13px; }
.media-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.player { position: relative; aspect-ratio: 16 / 9; background: #0F1A15; border-radius: 14px; overflow: hidden; max-width: 100%; }
.player svg.glove { position: absolute; inset: 8% 0 14% 0; width: 100%; height: 78%; }
.player.playing svg.glove { animation: flex 1.1s ease-in-out infinite; transform-origin: 50% 85%; }
@keyframes flex { 0%, 100% { transform: scale(1, 1) rotate(-2deg); } 50% { transform: scale(.94, 1.04) rotate(2deg); } }
.pbar { position: absolute; left: 12px; right: 12px; bottom: 10px; display: flex; align-items: center; gap: 10px; color: #E7F0EA; font-family: var(--font-mono); font-size: 12px; }
.pbar .bar { flex: 1; background: #2B3F36; }
.pbtn { position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); width: 64px; height: 64px; border-radius: 50%; border: 0; background: var(--accent); color: var(--accent-ink); font-size: 24px; cursor: pointer; }
.player.playing .pbtn { opacity: 0; pointer-events: none; }
.player .tag { position: absolute; top: 10px; left: 10px; font-family: var(--font-mono); font-size: 11px; color: #BFE8CF; background: #1F3029; padding: 3px 8px; border-radius: 6px; }
.v360 { display: flex; flex-direction: column; gap: 10px; }
.v360 .stage { cursor: grab; touch-action: pan-y; }
.v360 .stage:active { cursor: grabbing; }
.v360 input[type="range"] { width: 100%; accent-color: var(--accent); }
.close-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 24px; }
.close-grid figure { margin: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.close-grid .frame { aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: var(--soft); }
.close-grid svg { width: 100%; height: 100%; display: block; }
.close-grid figcaption { font-size: 14px; color: var(--muted); }
.field { display: flex; flex-direction: column; gap: 6px; padding: 14px 0; border-top: 1px solid var(--line); }
.field .lab { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
.field .val { font-size: 16px; overflow-wrap: anywhere; }
.field .val.title { font-family: var(--font-display); font-size: 20px; font-weight: 700; }
.field .cnt.ok { color: var(--ok); }
.field .cnt.over { color: var(--warn); }
.kw { display: flex; flex-wrap: wrap; gap: 8px; }
.kw span { font-size: 13px; padding: 5px 10px; border-radius: 999px; background: var(--soft); }
.kw span.primary { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
pre.code { margin: 0; padding: 16px; background: #0F1A15; color: #BFE8CF; border-radius: 12px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; overflow-x: auto; }
.mini-btn { font: 600 13px var(--font-body); padding: 5px 11px; border-radius: 8px; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; }
.mini-btn:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

/* project */
.proj { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 24px; }
.proj-text { display: flex; flex-direction: column; gap: 14px; max-width: 60ch; }
.proj-text b { font-family: var(--font-display); font-weight: 700; }
.proj-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; align-content: start; }

/* portrait + achievements */
.who { display: flex; align-items: center; gap: 16px; }
.who img { width: 104px; height: 104px; border-radius: 14px; object-fit: cover; object-position: 50% 18%; flex: none; background: var(--soft); }
.who b { font-family: var(--font-display); font-size: 22px; font-weight: 800; letter-spacing: -0.01em; display: block; line-height: 1.15; }
.who span { font-size: 14px; color: var(--muted); }
.certs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
.cert { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.cert button { all: unset; cursor: zoom-in; display: block; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; transition: transform .15s, border-color .15s; }
.cert button:hover { transform: translateY(-3px); border-color: var(--accent); }
.cert button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
.cert img { width: 100%; height: auto; display: block; max-width: 100%; }
.cert b { font-family: var(--font-display); font-size: 18px; line-height: 1.2; }
.cert span { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
.lightbox { position: fixed; inset: 0; z-index: 50; background: rgba(8, 14, 11, .88); display: flex; align-items: center; justify-content: center; padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) max(16px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); cursor: zoom-out; }
.lightbox img { max-width: 100%; max-height: 100%; border-radius: 10px; background: #fff; }
.lightbox .x { position: absolute; top: max(12px, env(safe-area-inset-top, 0px)); right: max(12px, env(safe-area-inset-right, 0px)); font: 600 14px var(--font-body); padding: 8px 14px; border-radius: 8px; border: 0; background: #fff; color: #12201A; cursor: pointer; }

/* more-about tabs */
.tabbed { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 24px; }
.tabbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.tabbar .chip { font-size: 15px; padding: 9px 16px; }
.panel[hidden] { display: none; }
.wins { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.win { border-top: 3px solid var(--accent); padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
.win h3 { font-size: 22px; }
.win p { color: var(--muted); font-size: 15px; }
.gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.shot { margin: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.shot .frame { aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden; background: var(--soft); max-width: 100%; }
.shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s; }
.shot:hover img { transform: scale(1.04); }
